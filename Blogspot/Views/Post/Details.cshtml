@model Post

@{

    ViewData["Title"] = Model.Title;
}
<style>
    .content-wrapper {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
        font-family: sans-serif
    }

    .feature-image {
        width: 100%;
        height: 500px;
        margin-bottom: 20px;
        border-radius: 5px;
        object-fit: cover;
    }   
</style>

<div class="text-end">
    <a class="btn btn-secondary my-3" asp-action="Edit" asp-route-id="@Model.Id">Edit Post</a>
    <a class="btn btn-danger my-3 mx-2" asp-action="Delete" asp-route-id="@Model.Id">Delete Post</a>
</div>

<div class="content-wrapper">
        <h1> @Model.Title</h1>
        <p><span class="badge bg-primary">By: </span>@Model.Author | <span class="badge bg-primary">Published: </span>@Model.PublishedDate.ToString("yyyy-MM-dd")</p>
         <p><span class ="badge bg-secondary" >Category: </span>@Model.Category.Name</p>
    <img src="@Model.FeatureImagePath" class="feature-image" alt="@Model.Title">

<hr/> 
<div>
        @Html.Raw(Model.Content)
</div>

<hr/>

    @if (Model.Comments.Any())
    {
     <div>
            @foreach (var comment in Model.Comments)
            {
                <div class="card mb-3 shadow-sm">
                   
                    <div class="card-body">
                        <h5 class="card-title">@comment.UserName</h5>
                        <p class="card-text">@comment.Content</p>
                        <p class="card-text"><small class="text-muted">Posted on @comment.CommentDate.ToString("yyyy-MM-dd HH:mm")</small></p>
                    </div>
                    
                </div>
            }
</div>   
    }
    else
    {
        <p class="text-muted">No comments yet. Be the first to comment!</p>
    }
    <h4>ADD a comment </h4>
     <form id="commentForm">
    <div class="form-group">
        <label for="Username">Name:</label>
        <input id="UserName" name="UserName" required class="form-control" />
    </div>
    <div class="form-group ">
        <label for="commentContent">Comment:</label>
        <textarea class="form-control" id="Content" name="Content" rows="4" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Submit Comment</button>
        </form>
</div>
@section Scripts {
    <script>
        $(function () {
            $('#commentForm').on('submit', function (event) {
                    event.preventDefault();

                    var userName = $('#UserName').val();
                    var content = $('#Content').val();
                    var postId = @Model.Id;

                    if (!userName || !content) {
                        alert('Please fill in both fields.');
                        return;
                    }

                    $.ajax({
                        url: '@Url.Action("AddComment", "Post")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            postId: postId,
                            userName: userName,
                            content: content
                        }),
                        success: function (response) {
                            console.log('Comment submitted successfully:', response);
                            $('#commentForm')[0].reset();
                        },
                        error: function (xhr, status, error) {
                            console.error('Error submitting comment:', error);
                        }
                    });
            });
        });
    </script>
}
